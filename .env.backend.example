# ─── LexiMind AI — Backend Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# Database (SQLite by default — change to PostgreSQL for production)
DATABASE_URL=sqlite:///./leximind.db
# DATABASE_URL=postgresql://user:password@localhost:5432/leximind

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Security (set a strong random string in production)
SECRET_KEY=change-me-to-a-long-random-string

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: OpenAI key for generative features (not required for local NLP)
# OPENAI_API_KEY=sk-...

# File upload limit in bytes (default 500 MB)
MAX_UPLOAD_SIZE=524288000
