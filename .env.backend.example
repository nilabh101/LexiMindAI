# ─── LexiMind AI — Backend Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# Database (SQLite by default — change to PostgreSQL for production)
DATABASE_URL=sqlite:///./leximind.db
# DATABASE_URL=postgresql://user:password@localhost:5432/leximind

# API settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Security (set a strong random string in production)
SECRET_KEY=change-me-to-a-long-random-string

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI / LLM (never commit real keys)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
HF_TOKEN=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Embeddings (tfidf needs no extra service; huggingface uses sentence-transformers)
EMBEDDING_PROVIDER=tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OCR: auto attempts Tesseract via PyMuPDF when extractable text is too short
OCR_ENABLED=auto
OCR_TEXT_THRESHOLD=80

# File upload limit in bytes (default 500 MB)
MAX_UPLOAD_SIZE=524288000
